#!/bin/sh
# leds: toggle Archer C7 v2 front LEDs. Guards missing sysfs (kernel bumps).
set -eu

leds1="/sys/devices/platform/leds/leds/tp-link:green:"

w() {
	# w <file> <value>: write only if target exists/writable.
	if [ -w "$1" ]; then
		printf '%s' "$2" > "$1"
	else
		echo "leds: warn: missing $1" >&2
		return 1
	fi
}

case "${1:-}" in
	on)
		w "${leds1}wlan2g/trigger" "phy1tpt" || true
		w "${leds1}wlan5g/trigger" "phy0tpt" || true
		w "${leds1}system/brightness" "255" || true
		w "${leds1}wlan2g/brightness" "255" || true
		w "${leds1}wlan5g/brightness" "255" || true
		;;
	off)
		w "${leds1}wlan2g/trigger" "none" || true
		w "${leds1}wlan5g/trigger" "none" || true
		w "${leds1}system/brightness" "0" || true
		w "${leds1}wlan2g/brightness" "0" || true
		w "${leds1}wlan5g/brightness" "0" || true
		;;
	*)
		echo "Usage: leds [on|off]" >&2; exit 1
		;;
esac
